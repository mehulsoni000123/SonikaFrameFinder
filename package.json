{
  "name": "sonika-framefinder", "version": "0.1.0", "private": true,
  "description": "A local-first visual reference companion for video editors",
  "author": "Sonika", "main": "desktop/main.cjs",
  "scripts": {"dev": "vite", "start": "npm run build && electron .", "typecheck": "tsc --noEmit", "build": "tsc --noEmit && vite build", "test": "node --test tests/*.test.cjs", "package:win": "npm run build && electron-builder --win nsis", "package:dir": "npm run build && electron-builder --win --dir"},
  "dependencies": {"react": "^19.2.0", "react-dom": "^19.2.0", "zod": "^4.0.0"},
  "devDependencies": {"@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "typescript": "^5.9.0", "vite": "^7.0.0", "electron": "45.0.0", "electron-builder": "^26.0.0", "@playwright/test": "^1.56.0"},
  "build": {"appId": "com.sonika.framefinder", "productName": "Sonika FrameFinder", "directories": {"output": "release"}, "files": ["dist/**/*", "desktop/**/*", "package.json"], "win": {"target": "nsis", "signAndEditExecutable": false}, "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}}
}
